# ── Whitelist: only track repo root layout (GitHub main view) ────────────────
# Screenshot: docs, report, src, tables, tasks + root configs/scripts.
# After merge: data_processing → feedback_synthesis,
#              run_data_processing.py → run_feedback_synthesis.py
# Everything else (results/, batch/, logs/, backups/, datasets/, …) stays local.

# Ignore all top-level entries
/*

# Root files
!/.gitignore
!/LICENSE
!/README.md
!/README_CN.md
!/download_datasets.sh
!/experiment_config.yaml
!/requirements.txt
!/run_all.py
!/run_feedback_synthesis.py

# Top-level directories (and all contents)
!/docs/
!/docs/**
!/feedback_synthesis/
!/feedback_synthesis/**
!/report/
!/report/**
!/src/
!/src/**
!/tables/
!/tables/**
!/tasks/
!/tasks/**

# ── Junk inside whitelisted trees (still ignored) ───────────────────────────
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
**/.env
**/.venv/
**/venv/
**/*.log
**/*.bak
**/*.bak_*
**/*.tmp
.DS_Store
.vscode/
.idea/
